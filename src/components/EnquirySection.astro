
---
import "../styles/EnquirySection.css";
---

<section class="enquiry-section" id="contact">
  <div class="enquiry-container">

    <!-- LEFT: PROJECT INTRO -->
    <div class="enquiry-intro">
      <span class="enquiry-eyebrow">SAI WORLD CITY PANVEL</span>

      <h2>
        DON'T JUST DREAM A BETTER HOME
        <em>MAKE IT YOURS.</em>
      </h2>

      <p>Share your details. We'll help you take the next step.</p>

      <div class="enquiry-watermark" aria-hidden="true">SWC.</div>
    </div>

    <!-- RIGHT: ENQUIRY FORM -->
    <div class="enquiry-form-panel">

      <div class="form-heading">
        <div>
          <span class="form-eyebrow">ENQUIRE NOW</span>
          <h3>Get Sai World City Panvel Details.</h3>
        </div>
      </div>

      <form
        class="project-enquiry-form"
        id="projectEnquiryForm"
      >

        <!-- FULL NAME -->
        <div class="form-field">
          <label for="contactName">FULL NAME</label>

          <input
            type="text"
            id="contactName"
            name="name"
            placeholder="Enter your name"
            autocomplete="name"
            required
          />
        </div>

        <!-- PHONE + CONFIGURATION -->
        <div class="form-grid">

          <div class="form-field">
            <label for="contactPhone">PHONE NUMBER</label>

            <div class="phone-input-wrap">
              <span class="phone-prefix">+91</span>
              <span class="phone-divider"></span>

              <input
                type="tel"
                id="contactPhone"
                name="phone"
                placeholder="10-digit mobile number"
                inputmode="numeric"
                autocomplete="tel-national"
                pattern="[6-9][0-9]{9}"
                maxlength="10"
                minlength="10"
                required
                aria-describedby="phoneHint"
              />
            </div>

            <span class="field-hint" id="phoneHint">
              Enter your 10-digit mobile number
            </span>
          </div>

          <div class="form-field">
            <label for="contactConfiguration">
              CONFIGURATION
            </label>

            <select
              id="contactConfiguration"
              name="configuration"
              required
            >
              <option value="" disabled selected>
                Select BHK
              </option>

              <option value="2 BHK">2 BHK</option>
              <option value="2.5 BHK">2.5 BHK</option>
              <option value="3 BHK">3 BHK</option>
              <option value="4 BHK">4 BHK</option>
            </select>
          </div>

        </div>

        <!-- SUBMIT BUTTON -->
        <button
          type="submit"
          class="form-submit"
          id="enquirySubmitButton"
        >
          <span class="submit-text">REQUEST A CALL BACK</span>
        </button>

        <p
          class="form-note"
          id="enquiryFormMessage"
          aria-live="polite"
        >
          Your details will only be used to respond to your enquiry.
        </p>

      </form>
    </div>

  </div>
</section>

<script>
  import emailjs from "@emailjs/browser";

  // ==========================================
  // EMAILJS CONFIGURATION
  // ==========================================

  const SERVICE_ID = "service_zykw8ue";
  const TEMPLATE_ID = "template_zt43j9a";
  const PUBLIC_KEY = "FOTLNhfG-RXdWql-8";

  // ==========================================
  // GOOGLE TAG MANAGER DATA LAYER
  // ==========================================

  type GTMEvent = Record<string, string | number>;

  type GTMWindow = Window & {
    dataLayer?: GTMEvent[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(eventData: GTMEvent) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // ==========================================
  // FORM ELEMENTS
  // ==========================================

  const enquiryForm =
    document.querySelector<HTMLFormElement>(
      "#projectEnquiryForm"
    );

  const phoneInput =
    document.querySelector<HTMLInputElement>(
      "#contactPhone"
    );

  const configurationInput =
    document.querySelector<HTMLSelectElement>(
      "#contactConfiguration"
    );

  const submitButton =
    document.querySelector<HTMLButtonElement>(
      "#enquirySubmitButton"
    );

  const submitText =
    submitButton?.querySelector<HTMLElement>(
      ".submit-text"
    );

  const formMessage =
    document.querySelector<HTMLElement>(
      "#enquiryFormMessage"
    );

  let isSubmitting = false;
  let formStarted = false;

  // ==========================================
  // ENQUIRY SECTION VISIBILITY TRACKING
  // ==========================================

  const enquirySection =
    document.querySelector<HTMLElement>(
      ".enquiry-section"
    );

  if (enquirySection) {

    const observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            pushGTMEvent({
              event: "enquiry_section_view",
              section_name: "Main Enquiry Section"
            });

            observer.unobserve(enquirySection);
          }

        });

      },
      {
        threshold: 0.3
      }
    );

    observer.observe(enquirySection);
  }

  // ==========================================
  // FORM START TRACKING
  // Fires on the first user interaction only
  // ==========================================

  enquiryForm?.addEventListener("focusin", () => {

    if (formStarted) return;

    formStarted = true;

    pushGTMEvent({
      event: "main_enquiry_form_start",
      form_name: "Main Enquiry Form",
      form_type: "website"
    });

  });

  // ==========================================
  // PHONE NUMBER VALIDATION
  // ==========================================

  phoneInput?.addEventListener("input", () => {

    phoneInput.value = phoneInput.value
      .replace(/\D/g, "")
      .slice(0, 10);

  });

  // ==========================================
  // FORM SUBMISSION
  // ==========================================

  enquiryForm?.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();

      // Prevent duplicate submissions
      if (isSubmitting) return;

      // Browser validation
      if (!enquiryForm.reportValidity()) return;

      const formData = new FormData(enquiryForm);

      const name = String(
        formData.get("name") || ""
      ).trim();

      const phone = String(
        formData.get("phone") || ""
      ).trim();

      const configuration = String(
        formData.get("configuration") || ""
      );

      // Additional phone validation
      if (!/^[6-9]\d{9}$/.test(phone)) {

        phoneInput?.setCustomValidity(
          "Please enter a valid 10-digit mobile number."
        );

        phoneInput?.reportValidity();
        phoneInput?.setCustomValidity("");

        return;
      }

      // ======================================
      // EMAILJS TEMPLATE PARAMETERS
      // ======================================

      const templateParams = {
        name: name,
        phone: "+91 " + phone,
        configuration: configuration,
      };

      // ======================================
      // LOADING STATE
      // ======================================

      isSubmitting = true;

      if (submitButton) {
        submitButton.disabled = true;

        submitButton.setAttribute(
          "aria-busy",
          "true"
        );
      }

      if (submitText) {
        submitText.textContent = "SUBMITTING...";
      }

      if (formMessage) {
        formMessage.textContent =
          "Please wait while we submit your enquiry...";
      }

      enquiryForm.querySelector(
        ".enquiry-error"
      )?.remove();

      // ======================================
      // SEND ENQUIRY THROUGH EMAILJS
      // ======================================

      try {

        const response = await emailjs.send(
          SERVICE_ID,
          TEMPLATE_ID,
          templateParams,
          {
            publicKey: PUBLIC_KEY,
          }
        );

        console.log(
          "Enquiry submitted successfully:",
          response.status
        );

        // ======================================
        // GTM: SUCCESSFUL ENQUIRY
        // Only after EmailJS success
        // ======================================

        pushGTMEvent({
          event: "main_enquiry_submit",
          form_name: "Main Enquiry Form",
          form_type: "website",
          configuration: configuration,
          submission_status: "success"
        });

        // ======================================
        // CUSTOM SUCCESS EVENT
        // ======================================

        window.dispatchEvent(
          new CustomEvent("project-enquiry-submit", {
            detail: {
              name,
              phone,
              configuration,
              country_code: "+91",
              full_phone: "+91" + phone,
            },
          })
        );

        if (submitText) {
          submitText.textContent = "SUCCESS!";
        }

        if (formMessage) {
          formMessage.textContent =
            "Thank you! Redirecting...";
        }

        // ======================================
        // THANK YOU PAGE REDIRECT
        // ======================================

        window.location.replace("/thank-you/");

      } catch (error) {

        console.error(
          "EmailJS submission failed:",
          error
        );

        // ======================================
        // GTM: SUBMISSION ERROR
        // ======================================

        pushGTMEvent({
          event: "main_enquiry_error",
          form_name: "Main Enquiry Form",
          form_type: "website",
          submission_status: "error"
        });

        const errorMessage =
          document.createElement("p");

        errorMessage.className = "enquiry-error";

        errorMessage.textContent =
          "Submission failed. Please try again or contact our team.";

        enquiryForm.appendChild(errorMessage);

        if (formMessage) {
          formMessage.textContent =
            "We couldn't submit your enquiry. Please try again.";
        }

        // Allow another submission attempt
        isSubmitting = false;

        if (submitButton) {
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");
        }

        if (submitText) {
          submitText.textContent =
            "REQUEST A CALL BACK";
        }

      }

    }
  );
</script>

<style>
  /* Submission feedback */

  .form-submit:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  .enquiry-error {
    margin-top: 12px;
    color: #b42318;
    font-size: 12px;
    line-height: 1.5;
  }
</style>
