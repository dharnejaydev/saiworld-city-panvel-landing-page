
---
import "../styles/FAQ.css";

const faqs = [
  {
    question: "Has Sai World City Panvel received a valid MahaRERA registration?",
    answer:
      "Yes, Paradise Sai World City in Panvel is RERA approved.",
  },
  {
    question: "Which flat configurations are offered in Sai World City Panvel?",
    answer:
      "Sai World City Panvel apartments are available in 2 BHK, 2.5 BHK, 3 BHK, and 4 BHK configurations.",
  },
  {
    question: "What are the key landmark and location details of Sai World City Panvel?",
    answer:
      "Sai World City Panvel is located at Palaspe Phata Junction, NH 4B, JNPT Road, Panvel, Navi Mumbai – 410206.",
  },
  {
    question: "What features and lifestyle amenities does Sai World City Panvel provide?",
    answer:
      "Sai World City Panvel offers global-themed amenities centered around its G+5 mega clubhouse (Club Vegas).",
  },
  {
    question: "How many acres is Sai World City Panvel spread across?",
    answer:
      "The Sai World City Panvel township project in Panvel spans 32 acres.",
  },
  {
    question: "What is the name of the mega clubhouse at Sai World City Panvel?",
    answer:
      "The mega clubhouse at Sai World City Panvel is known as Club Vegas.",
  },
  {
    question: "What is the total area of the Sai World City Panvel township?",
    answer:
      "Sai World City Panvel is spread across 32 acres.",
  },
];
---

<section class="faq-section" id="faq">
  <div class="faq-container">

    <div class="faq-heading">
      <div>
        <h2>
          <span class="faq-heading-main">
            Frequently Asked Questions About
          </span>
          <em>Sai World City Panvel</em>
        </h2>
      </div>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <article class={`faq-item ${index === 0 ? "is-active" : ""}`}>
          <button
            class="faq-question"
            type="button"
            aria-expanded={index === 0 ? "true" : "false"}
            aria-controls={`faq-answer-${index}`}
          >
            <span class="faq-number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <span class="faq-question-text">
              {faq.question}
            </span>

            <span class="faq-toggle" aria-hidden="true"></span>
          </button>

          <div
            class="faq-answer"
            id={`faq-answer-${index}`}
            hidden={index !== 0}
          >
            <p>{faq.answer}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  // ==========================================
  // GOOGLE TAG MANAGER DATA LAYER
  // ==========================================

  type GTMEvent = Record<string, string | number>;

  type GTMWindow = Window & {
    dataLayer?: GTMEvent[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(eventData: GTMEvent) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // ==========================================
  // FAQ SECTION INITIALIZATION
  // ==========================================

  document.querySelectorAll<HTMLElement>(
    ".faq-section:not([data-ready])"
  ).forEach((section) => {

    section.dataset.ready = "true";

    const items = Array.from(
      section.querySelectorAll<HTMLElement>(".faq-item")
    );

    // ========================================
    // KEEP EXACTLY ONE FAQ OPEN
    // First FAQ is open by default
    // ========================================

    let activeIndex = 0;

    function openFAQ(index: number) {

      items.forEach((item, itemIndex) => {

        const button =
          item.querySelector<HTMLButtonElement>(
            ".faq-question"
          );

        const answer =
          item.querySelector<HTMLElement>(
            ".faq-answer"
          );

        const isActive = itemIndex === index;

        item.classList.toggle("is-active", isActive);

        button?.setAttribute(
          "aria-expanded",
          String(isActive)
        );

        if (answer) {
          answer.hidden = !isActive;
        }

      });

      activeIndex = index;
    }

    // Ensure the first FAQ is open on initialization
    openFAQ(0);

    // ========================================
    // FAQ CLICK TRACKING + ACCORDION
    // ========================================

    items.forEach((item, index) => {

      const button =
        item.querySelector<HTMLButtonElement>(
          ".faq-question"
        );

      const questionText =
        item.querySelector<HTMLElement>(
          ".faq-question-text"
        );

      button?.addEventListener("click", () => {

        // Clicking the already open FAQ does nothing.
        // One FAQ must always remain open.
        if (activeIndex === index) return;

        // Open the selected FAQ and close the previous one
        openFAQ(index);

        // ====================================
        // GTM: FAQ ITEM INTERACTION
        // ====================================

        pushGTMEvent({
          event: "faq_item_toggle",
          faq_number: index + 1,
          faq_question: questionText?.textContent?.trim() || "",
          faq_section: "Sai World City Panvel FAQ",
          interaction_type: "open"
        });

      });

    });

    // ========================================
    // GTM: FAQ SECTION VIEW TRACKING
    // ========================================

    const observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            pushGTMEvent({
              event: "faq_section_view",
              section_name: "Frequently Asked Questions",
              section_id: "faq"
            });

            observer.unobserve(section);
          }

        });

      },
      {
        threshold: 0.3
      }
    );

    observer.observe(section);

  });
</script>
