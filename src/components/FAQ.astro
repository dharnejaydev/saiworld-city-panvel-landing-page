
---
import "../styles/FAQ.css";

const faqs = [
  {
    question: "Has Sai World City Panvel received a valid MahaRERA registration?",
    answer:
      "Yes, Paradise Sai World City in Panvel is RERA approved.",
  },
  {
    question: "Which flat configurations are offered in Sai World City Panvel?",
    answer:
      "Sai World City Panvel apartments are available in 2 BHK, 2.5 BHK, 3 BHK, and 4 BHK configurations.",
  },
  {
    question: "What are the key landmark and location details of Sai World City Panvel?",
    answer:
      "Sai World City Panvel is located at Palaspe Phata Junction, NH 4B, JNPT Road, Panvel, Navi Mumbai – 410206.",
  },
  {
    question: "What features and lifestyle amenities does Sai World City Panvel provide?",
    answer:
      "Sai World City Panvel offers global-themed amenities centered around its G+5 mega clubhouse (Club Vegas).",
  },
  {
    question: "How many acres is Sai World City Panvel spread across?",
    answer:
      "The Sai World City Panvel township project in Panvel spans 32 acres.",
  },
  {
    question: "What is the name of the mega clubhouse at Sai World City Panvel?",
    answer:
      "The mega clubhouse at Sai World City Panvel is known as Club Vegas.",
  },
  {
    question: "What is the total area of the Sai World City Panvel township?",
    answer:
      "Sai World City Panvel is spread across 32 acres.",
  },
];
---

<section class="faq-section" id="faq">
  <div class="faq-container">

    <div class="faq-heading">
      <div>
        <h2>
          Frequently Asked
          <em>Questions.</em>
        </h2>
      </div>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <article class="faq-item">
          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
          >
            <span class="faq-number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <span class="faq-question-text">
              {faq.question}
            </span>

            <span class="faq-toggle" aria-hidden="true"></span>
          </button>

          <div
            class="faq-answer"
            id={`faq-answer-${index}`}
            hidden
          >
            <p>{faq.answer}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  document.querySelectorAll(".faq-section").forEach((section) => {
    const items = Array.from(section.querySelectorAll(".faq-item"));

    items.forEach((item) => {
      const button = item.querySelector(".faq-question");
      const answer = item.querySelector(".faq-answer");

      button?.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";

        items.forEach((otherItem) => {
          const otherButton = otherItem.querySelector(".faq-question");
          const otherAnswer = otherItem.querySelector(".faq-answer");

          otherItem.classList.remove("is-active");
          otherButton?.setAttribute("aria-expanded", "false");

          if (otherAnswer) {
            otherAnswer.hidden = true;
          }
        });

        if (!isOpen) {
          item.classList.add("is-active");
          button.setAttribute("aria-expanded", "true");

          if (answer) {
            answer.hidden = false;
          }
        }
      });
    });
  });
</script>
