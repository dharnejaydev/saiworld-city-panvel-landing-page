
---
import "../styles/hero.css";
import Header from "./Header.astro";
import PopupForm from "./PopupForm.astro";

const phoneNumber = "+919920968878";

const highlights = [
  {
    icon: "home",
    label: "RESIDENCE OPTIONS",
    title: "2, 2.5, 3 & 4 BHK",
  },
  {
    icon: "township",
    label: "INTEGRATED TOWNSHIP",
    title: "38 Acres",
  },
  {
    icon: "amenities",
    label: "LIFESTYLE",
    title: "50+ Amenities",
  },
  {
    icon: "club",
    label: "CLUB VEGAS",
    title: "50,000+ Sq. Ft.",
  },
];
---

<section class="swc-hero" id="top">

  <div class="swc-hero-background">
    <img
      src="/images/hero/sai-world-city-main.webp"
      alt="Sai World City residential development in Panvel"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="swc-hero-overlay"></div>

  <Header />

  <div class="swc-hero-container">
    <div class="swc-hero-content">

      <h1 class="swc-hero-heading">
        <span class="swc-project-name">
          SAI WORLD <br />
          CITY PANVEL
        </span>

        <span class="swc-hero-tagline">
          ELEVATE YOUR LIFESTYLE
        </span>
      </h1>

      <div class="swc-location">
        <span class="swc-location-line"></span>
        <span>PALASPE PHATA</span>
        <span class="swc-location-line"></span>
      </div>

      <!-- PRIMARY SITE VISIT CTA -->
      <div class="swc-actions">
        <a
          href="#contact"
          class="swc-primary-btn js-open-lead-form"
          data-hero-site-visit
        >
          <span>Book Free Site Visit</span>
        </a>
      </div>

      <!-- BOTH CLICKABLE PHONE NUMBERS -->
      <div class="swc-hero-phone-pill">

        <a
          href="tel:+919920968878"
          aria-label="Call +91 99209 68878"
          data-hero-phone="9920968878"
        >
          +91 99209 68878
        </a>

        <span class="swc-phone-divider" aria-hidden="true">||</span>

        <a
          href="tel:+918879957281"
          aria-label="Call +91 88799 57281"
          data-hero-phone="8879957281"
        >
          +91 88799 57281
        </a>

      </div>

    </div>
  </div>

  <!-- PROJECT HIGHLIGHTS -->
  <div class="swc-highlight-wrapper">
    <div class="swc-highlight-panel">

      {highlights.map((item) => (
        <div class="swc-highlight-item">

          <div class="swc-highlight-icon">

            {item.icon === "home" && (
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M5 21L24 6L43 21V43H5V21Z" />
                <path d="M17 43V27H31V43" />
                <path d="M11 23V15H17" />
                <path d="M34 11V5H40V16" />
              </svg>
            )}

            {item.icon === "township" && (
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M5 43V17L17 10V43" />
                <path d="M17 43V5H32V43" />
                <path d="M32 43V19L43 13V43" />
                <path d="M10 23H12M10 30H12M10 37H12" />
                <path d="M22 13H27M22 21H27M22 29H27M22 37H27" />
                <path d="M37 25H39M37 33H39" />
              </svg>
            )}

            {item.icon === "amenities" && (
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M24 4L29 18L44 24L29 30L24 44L19 30L4 24L19 18L24 4Z" />
                <path d="M24 17V31M17 24H31" />
              </svg>
            )}

            {item.icon === "club" && (
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path d="M5 43H43" />
                <path d="M8 43V18L24 7L40 18V43" />
                <path d="M17 43V28H31V43" />
                <path d="M14 20H18M22 20H26M30 20H34" />
                <path d="M20 7V3H28V7" />
              </svg>
            )}

          </div>

          <div class="swc-highlight-text">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
          </div>

        </div>
      ))}

    </div>
  </div>

</section>

<!-- FLOATING CONTACT BUTTONS -->

<div class="swc-floating-contact">

  <!-- WHATSAPP -->
  <a
    href="https://wa.me/919920968878?text=Hi%2C%20I%27m%20interested%20in%20Sai%20World%20City%20Panvel.%20Please%20share%20more%20details."
    class="swc-float-btn swc-float-whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
    data-hero-whatsapp
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.52 3.48A11.8 11.8 0 0 0 12.13 0C5.6 0 .3 5.3.3 11.82c0 2.08.55 4.12 1.6 5.92L.2 24l6.42-1.68a11.9 11.9 0 0 0 5.5 1.4h.01c6.52 0 11.82-5.3 11.82-11.82a11.8 11.8 0 0 0-3.43-8.42ZM12.13 21.7a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.81 1 1.02-3.71-.23-.38a9.83 9.83 0 0 1-1.51-5.19c0-5.46 4.45-9.91 9.92-9.91a9.85 9.85 0 0 1 7.02 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.46-4.45 9.91-9.9 9.91Zm5.44-7.42c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z" />
    </svg>
  </a>

  <!-- CALL -->
  <a
    href="tel:+919920968878"
    class="swc-float-btn swc-float-call"
    aria-label="Call Sai World City"
    data-hero-floating-call
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
    </svg>
  </a>

</div>

<!-- POPUP ENQUIRY FORM -->
<PopupForm />

<!-- ==========================================
     GOOGLE TAG MANAGER TRACKING
========================================== -->

<script>
  type GTMEvent = Record<string, string | number>;

  type GTMWindow = Window & {
    dataLayer?: GTMEvent[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(eventData: GTMEvent) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // ==========================================
  // HERO SECTION INITIALIZATION
  // ==========================================

  document.querySelectorAll<HTMLElement>(
    ".swc-hero:not([data-ready])"
  ).forEach((hero) => {

    hero.setAttribute("data-ready", "true");

    // ==========================================
    // HERO SECTION VISIBILITY
    // ==========================================

    const observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            pushGTMEvent({
              event: "hero_section_view",
              section_name: "Sai World City Hero"
            });

            observer.unobserve(hero);
          }

        });

      },
      {
        threshold: 0.3
      }
    );

    observer.observe(hero);

    // ==========================================
    // BOOK FREE SITE VISIT CLICK
    // ==========================================

    const siteVisitButton =
      hero.querySelector<HTMLAnchorElement>(
        "[data-hero-site-visit]"
      );

    siteVisitButton?.addEventListener("click", () => {

      pushGTMEvent({
        event: "hero_site_visit_click",
        button_name: "Book Free Site Visit",
        section_name: "Hero",
        form_type: "popup"
      });

    });

    // ==========================================
    // HERO PHONE NUMBER CLICK
    // ==========================================

    const phoneLinks =
      hero.querySelectorAll<HTMLAnchorElement>(
        "[data-hero-phone]"
      );

    phoneLinks.forEach((link) => {

      link.addEventListener("click", () => {

        pushGTMEvent({
          event: "hero_phone_click",
          phone_label: link.dataset.heroPhone || "",
          section_name: "Hero",
          destination: "phone_call"
        });

      });

    });

  });

  // ==========================================
  // FLOATING WHATSAPP CLICK
  // ==========================================

  document.querySelectorAll<HTMLAnchorElement>(
    "[data-hero-whatsapp]"
  ).forEach((button) => {

    button.addEventListener("click", () => {

      pushGTMEvent({
        event: "hero_whatsapp_click",
        button_name: "Floating WhatsApp",
        section_name: "Hero",
        destination: "whatsapp"
      });

    });

  });

  // ==========================================
  // FLOATING CALL CLICK
  // ==========================================

  document.querySelectorAll<HTMLAnchorElement>(
    "[data-hero-floating-call]"
  ).forEach((button) => {

    button.addEventListener("click", () => {

      pushGTMEvent({
        event: "hero_floating_call_click",
        button_name: "Floating Call",
        section_name: "Hero",
        destination: "phone_call"
      });

    });

  });
</script>
