
---
import "../styles/PopupForm.css";
---

<div class="enquiry-modal" id="enquiry-modal" hidden>
  <button
    class="enquiry-backdrop"
    type="button"
    aria-label="Close enquiry form"
    data-close-enquiry
  ></button>

  <section
    class="enquiry-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="enquiry-title"
  >
    <div class="enquiry-visual">
      <div class="enquiry-visual-content">
        <div class="enquiry-brand"></div>
      </div>
    </div>

    <div class="enquiry-form-panel">
      <button
        class="enquiry-close"
        type="button"
        aria-label="Close enquiry form"
        data-close-enquiry
      >
        <span>Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>

      <div class="enquiry-form-heading">
        <span class="enquiry-form-eyebrow">PERSONAL SITE VISIT</span>

        <h2 id="enquiry-title">
          Experience it. Before you call it home.
        </h2>

        <p>
          Book your complimentary site visit and explore Sai World City
          in person. Share your details.
        </p>
      </div>

      <form class="enquiry-form" id="enquiry-form">
        <div class="enquiry-field">
          <label for="enquiry-name">Your name</label>
          <input
            id="enquiry-name"
            name="name"
            type="text"
            placeholder="Enter your full name"
            autocomplete="name"
            required
          />
        </div>

        <div class="enquiry-field">
          <label for="enquiry-phone">Mobile number</label>

          <div class="enquiry-phone-wrap">
            <span>+91</span>
            <input
              id="enquiry-phone"
              name="phone"
              type="tel"
              placeholder="Enter your 10-digit number"
              inputmode="numeric"
              autocomplete="tel-national"
              pattern="[6-9][0-9]{9}"
              maxlength="10"
              minlength="10"
              required
            />
          </div>
        </div>

        <div class="enquiry-field">
          <label for="enquiry-configuration">Interested in</label>

          <select
            id="enquiry-configuration"
            name="configuration"
            required
          >
            <option value="" disabled selected>
              Select configuration
            </option>
            <option value="2 BHK">2 BHK</option>
            <option value="2.5 BHK">2.5 BHK</option>
            <option value="3 BHK">3 BHK</option>
            <option value="4 BHK">4 BHK</option>
          </select>
        </div>

        <button class="enquiry-submit" type="submit">
          <span class="enquiry-submit-text">
            Schedule My Site Visit
          </span>
          <span class="enquiry-spinner" aria-hidden="true"></span>
        </button>

        <p class="enquiry-privacy">
          Our team will contact you to coordinate your preferred visit.
        </p>

        <p
          class="enquiry-error"
          id="enquiry-error"
          role="alert"
          hidden
        ></p>
      </form>

      <div class="enquiry-bottom-note">
        <span class="enquiry-bottom-line"></span>
        <span class="enquiry-bottom-line"></span>
      </div>
    </div>
  </section>
</div>

<script>
  import emailjs from "@emailjs/browser";

  // ==========================================
  // EMAILJS CONFIGURATION
  // ==========================================

  const SERVICE_ID = "service_zykw8ue";
  const TEMPLATE_ID = "template_zt43j9a";
  const PUBLIC_KEY = "FOTLNhfG-RXdWql-8";

  // ==========================================
  // GOOGLE TAG MANAGER DATA LAYER
  // ==========================================

  type GTMEvent = Record<string, string | number>;

  type GTMWindow = Window & {
    dataLayer?: GTMEvent[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(eventData: GTMEvent) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // ==========================================
  // POPUP ELEMENTS
  // ==========================================

  const modal = document.querySelector<HTMLElement>(
    "#enquiry-modal"
  );

  const form = document.querySelector<HTMLFormElement>(
    "#enquiry-form"
  );

  const nameInput = document.querySelector<HTMLInputElement>(
    "#enquiry-name"
  );

  const phoneInput = document.querySelector<HTMLInputElement>(
    "#enquiry-phone"
  );

  const submitButton = form?.querySelector<HTMLButtonElement>(
    ".enquiry-submit"
  );

  const buttonText = form?.querySelector<HTMLElement>(
    ".enquiry-submit-text"
  );

  const errorMessage = document.querySelector<HTMLElement>(
    "#enquiry-error"
  );

  const configurationInput =
    document.querySelector<HTMLSelectElement>(
      "#enquiry-configuration"
    );

  let previousFocus: HTMLElement | null = null;

  let firstPopupTimer: number | undefined;
  let secondPopupTimer: number | undefined;

  let popupDismissed = false;
  let formSubmitted = false;
  let isSubmitting = false;

  // ==========================================
  // OPEN POPUP
  // ==========================================

  function openEnquiry(source: string = "unknown") {
    if (!modal || !modal.hidden || formSubmitted) return;

    previousFocus =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;

    modal.hidden = false;

    document.body.classList.add("enquiry-modal-open");

    // GTM: POPUP OPEN
    pushGTMEvent({
      event: "popup_enquiry_view",
      popup_name: "Personal Site Visit",
      popup_trigger: source
    });

    window.setTimeout(() => {
      nameInput?.focus();
    }, 100);
  }

  // ==========================================
  // CLOSE POPUP
  // ==========================================

  function closeEnquiry() {
    if (!modal || modal.hidden || isSubmitting) return;

    modal.hidden = true;

    document.body.classList.remove("enquiry-modal-open");

    // GTM: POPUP CLOSE
    pushGTMEvent({
      event: "popup_enquiry_close",
      popup_name: "Personal Site Visit"
    });

    previousFocus?.focus();
  }

  // ==========================================
  // AUTOMATIC POPUP TIMERS
  // ==========================================

  // First popup: 8 seconds after arrival.
  firstPopupTimer = window.setTimeout(() => {
    if (!popupDismissed && !formSubmitted) {
      openEnquiry("automatic_8_seconds");
    }
  }, 8000);

  // Second popup: 35 seconds after arrival.
  secondPopupTimer = window.setTimeout(() => {
    if (
      popupDismissed &&
      !formSubmitted &&
      modal?.hidden
    ) {
      popupDismissed = false;
      openEnquiry("automatic_35_seconds");
    }
  }, 35000);

  // ==========================================
  // MANUAL ENQUIRY BUTTONS
  // ==========================================

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const trigger = target.closest(
      ".js-open-lead-form, a[href='#contact'], [data-open-enquiry]"
    );

    if (!trigger) return;

    event.preventDefault();

    if (firstPopupTimer !== undefined) {
      window.clearTimeout(firstPopupTimer);
      firstPopupTimer = undefined;
    }

    openEnquiry("manual_click");
  });

  // ==========================================
  // CLOSE BUTTON AND BACKDROP
  // ==========================================

  modal?.querySelectorAll<HTMLElement>(
    "[data-close-enquiry]"
  ).forEach((element) => {
    element.addEventListener("click", () => {
      popupDismissed = true;
      closeEnquiry();
    });
  });

  // ==========================================
  // ESCAPE KEY
  // ==========================================

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      modal &&
      !modal.hidden
    ) {
      popupDismissed = true;
      closeEnquiry();
    }
  });

  // ==========================================
  // PHONE VALIDATION
  // ==========================================

  phoneInput?.addEventListener("input", () => {
    phoneInput.value = phoneInput.value
      .replace(/\D/g, "")
      .slice(0, 10);
  });

  // ==========================================
  // SUBMISSION LOADING STATE
  // ==========================================

  function setLoading(loading: boolean) {
    isSubmitting = loading;

    if (submitButton) {
      submitButton.disabled = loading;

      submitButton.classList.toggle(
        "is-loading",
        loading
      );

      submitButton.setAttribute(
        "aria-busy",
        String(loading)
      );
    }

    if (buttonText) {
      buttonText.textContent = loading
        ? "Submitting your enquiry..."
        : "Schedule My Site Visit";
    }
  }

  // ==========================================
  // EMAILJS FORM SUBMISSION
  // ==========================================

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (isSubmitting || formSubmitted) return;

    if (!form.reportValidity()) return;

    const phone = String(
      phoneInput?.value || ""
    ).trim();

    if (!/^[6-9]\d{9}$/.test(phone)) {
      phoneInput?.setCustomValidity(
        "Please enter a valid 10-digit mobile number."
      );

      phoneInput?.reportValidity();
      phoneInput?.setCustomValidity("");

      return;
    }

    const formData = new FormData(form);

    const templateParams = {
      name: String(
        formData.get("name") || ""
      ).trim(),

      phone: "+91 " + phone,

      configuration: String(
        formData.get("configuration") || ""
      ),
    };

    if (errorMessage) {
      errorMessage.textContent = "";
      errorMessage.hidden = true;
    }

    setLoading(true);

    try {
      const response = await emailjs.send(
        SERVICE_ID,
        TEMPLATE_ID,
        templateParams,
        {
          publicKey: PUBLIC_KEY,
        }
      );

      console.log(
        "EmailJS submission successful:",
        response.status
      );

      formSubmitted = true;

      // ==========================================
      // GTM: SUCCESSFUL LEAD SUBMISSION
      // Fires only after EmailJS succeeds.
      // ==========================================

      pushGTMEvent({
        event: "popup_enquiry_submit",
        form_name: "Personal Site Visit Popup",
        form_type: "popup",
        configuration:
          configurationInput?.value || "",
        submission_status: "success"
      });

      if (firstPopupTimer !== undefined) {
        window.clearTimeout(firstPopupTimer);
      }

      if (secondPopupTimer !== undefined) {
        window.clearTimeout(secondPopupTimer);
      }

      if (buttonText) {
        buttonText.textContent = "Submitted successfully!";
      }

      form.reset();

      window.location.replace("/thank-you/");

    } catch (error) {
      console.error(
        "EmailJS submission failed:",
        error
      );

      // GTM: SUBMISSION ERROR
      pushGTMEvent({
        event: "popup_enquiry_error",
        form_name: "Personal Site Visit Popup",
        form_type: "popup",
        submission_status: "error"
      });

      if (errorMessage) {
        errorMessage.textContent =
          "Unable to submit your enquiry. Please try again or contact us on WhatsApp.";

        errorMessage.hidden = false;
      }

      setLoading(false);
    }
  });
</script>

<style>
  /* Submission loading state */
  .enquiry-submit {
    position: relative;
  }

  .enquiry-submit:disabled {
    opacity: 0.75;
    cursor: wait;
  }

  .enquiry-spinner {
    display: none;
    width: 16px;
    height: 16px;
    margin-left: 10px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: enquiry-spin 0.7s linear infinite;
  }

  .enquiry-submit.is-loading .enquiry-spinner {
    display: inline-block;
  }

  .enquiry-error {
    margin-top: 12px;
    color: #b42318;
    font-size: 12px;
    line-height: 1.5;
  }

  @keyframes enquiry-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enquiry-spinner {
      animation: none;
    }
  }
</style>
