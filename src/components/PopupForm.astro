
---
import "../styles/PopupForm.css";
---

<div class="enquiry-modal" id="enquiry-modal" hidden>
  <button
    class="enquiry-backdrop"
    type="button"
    aria-label="Close enquiry form"
    data-close-enquiry
  ></button>

  <section
    class="enquiry-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="enquiry-title"
  >
    <!-- LEFT: EDITORIAL PANEL -->
    <div class="enquiry-visual">
      <div class="enquiry-visual-content">
        <div class="enquiry-brand"></div>
      </div>
    </div>

    <!-- RIGHT: FORM PANEL -->
    <div class="enquiry-form-panel">
      <button
        class="enquiry-close"
        type="button"
        aria-label="Close enquiry form"
        data-close-enquiry
      >
        <span>Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>

      <div class="enquiry-form-heading">
        <span class="enquiry-form-eyebrow">PERSONAL SITE VISIT</span>

        <h2 id="enquiry-title">
          Experience it. Before you call it home.
        </h2>

        <p>
          Book your complimentary site visit and explore Sai World City
          in person. Share your details.
        </p>
      </div>

      <form class="enquiry-form" id="enquiry-form">
        <div class="enquiry-field">
          <label for="enquiry-name">Your name</label>
          <input
            id="enquiry-name"
            name="name"
            type="text"
            placeholder="Enter your full name"
            autocomplete="name"
            required
          />
        </div>

        <div class="enquiry-field">
          <label for="enquiry-phone">Mobile number</label>

          <div class="enquiry-phone-wrap">
            <span>+91</span>
            <input
              id="enquiry-phone"
              name="phone"
              type="tel"
              placeholder="Enter your 10-digit number"
              inputmode="numeric"
              autocomplete="tel-national"
              pattern="[6-9][0-9]{9}"
              maxlength="10"
              required
            />
          </div>
        </div>

        <div class="enquiry-field">
          <label for="enquiry-configuration">Interested in</label>

          <select
            id="enquiry-configuration"
            name="configuration"
            required
          >
            <option value="" disabled selected>
              Select configuration
            </option>
            <option value="2 BHK">2 BHK</option>
            <option value="2.5 BHK">2.5 BHK</option>
            <option value="3 BHK">3 BHK</option>
            <option value="4 BHK">4 BHK</option>
          </select>
        </div>

        <button class="enquiry-submit" type="submit">
          <span>Schedule My Site Visit</span>
        </button>

        <p class="enquiry-privacy">
          Our team will contact you to coordinate your preferred visit.
        </p>
      </form>

      <div class="enquiry-bottom-note">
        <span class="enquiry-bottom-line"></span>
        <span class="enquiry-bottom-line"></span>
      </div>
    </div>
  </section>
</div>

<script>
  import emailjs from "@emailjs/browser";

  // ==========================================
  // EMAILJS CONFIGURATION
  // ==========================================

  const SERVICE_ID = "service_zykw8ue";
const TEMPLATE_ID = "template_zt43j9a";
  const PUBLIC_KEY = "FOTLNhfG-RXdWql-8";

  // ==========================================
  // POPUP ELEMENTS
  // ==========================================

  const modal = document.querySelector<HTMLElement>(
    "#enquiry-modal"
  );

  const form = document.querySelector<HTMLFormElement>(
    "#enquiry-form"
  );

  const nameInput = document.querySelector<HTMLInputElement>(
    "#enquiry-name"
  );

  const popupDismissedKey = "swc-enquiry-popup-dismissed";

  let previousFocus: HTMLElement | null = null;
  let autoPopupTimer: number | undefined;

  // ==========================================
  // OPEN POPUP
  // ==========================================

  function openEnquiry() {
    if (!modal || !modal.hidden) return;

    previousFocus =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;

    modal.hidden = false;

    document.body.classList.add("enquiry-modal-open");

    window.setTimeout(() => {
      nameInput?.focus();
    }, 100);
  }

  // ==========================================
  // CLOSE POPUP
  // ==========================================

  function closeEnquiry() {
    if (!modal || modal.hidden) return;

    modal.hidden = true;

    document.body.classList.remove("enquiry-modal-open");

    previousFocus?.focus();
  }

  // ==========================================
  // AUTOMATIC POPUP AFTER 3 SECONDS
  // ==========================================

  // Popup appears on every page visit/reload
  // until the visitor dismisses it.

  if (!localStorage.getItem(popupDismissedKey)) {
    autoPopupTimer = window.setTimeout(() => {
      openEnquiry();
    }, 3000);
  }

  // ==========================================
  // MANUAL ENQUIRY BUTTONS
  // ==========================================

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const trigger = target.closest(
      ".js-open-lead-form, a[href='#contact']"
    );

    if (trigger) {
      event.preventDefault();

      if (autoPopupTimer !== undefined) {
        window.clearTimeout(autoPopupTimer);
      }

      openEnquiry();
    }
  });

  // ==========================================
  // CLOSE BUTTON AND BACKDROP
  // ==========================================

  modal?.querySelectorAll<HTMLElement>(
    "[data-close-enquiry]"
  ).forEach((element) => {
    element.addEventListener("click", () => {
      // Remember dismissal across refreshes and future visits.
      localStorage.setItem(popupDismissedKey, "true");

      if (autoPopupTimer !== undefined) {
        window.clearTimeout(autoPopupTimer);
      }

      closeEnquiry();
    });
  });

  // ==========================================
  // ESCAPE KEY
  // ==========================================

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal && !modal.hidden) {
      localStorage.setItem(popupDismissedKey, "true");
      closeEnquiry();
    }
  });

  // ==========================================
  // EMAILJS FORM SUBMISSION
  // ==========================================

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const submitButton =
      form.querySelector<HTMLButtonElement>(".enquiry-submit");

    const buttonText =
      submitButton?.querySelector("span");

    const formData = new FormData(form);

    const templateParams = {
      name: String(formData.get("name") || "").trim(),

      phone:
        "+91 " +
        String(formData.get("phone") || "").trim(),

      configuration: String(
        formData.get("configuration") || ""
      ),
    };

    // Remove previous error.
    form.querySelector(".enquiry-error")?.remove();

    // Disable button while sending.
    if (submitButton) {
      submitButton.disabled = true;
    }

    if (buttonText) {
      buttonText.textContent = "Sending...";
    }

    try {
      // Send enquiry to EmailJS.
      const response = await emailjs.send(
        SERVICE_ID,
        TEMPLATE_ID,
        templateParams,
        {
          publicKey: PUBLIC_KEY,
        }
      );

      console.log("EmailJS submission successful:", response);

      // Remember successful submission.
      localStorage.setItem(popupDismissedKey, "true");

      // Clear the form.
      form.reset();

      // Redirect only after successful submission.
      window.location.assign("/thank-you/");

    } catch (error) {
      console.error("EmailJS submission failed:", error);

      const errorMessage = document.createElement("p");

      errorMessage.className = "enquiry-error";

      errorMessage.textContent =
        "Unable to submit your enquiry. Please try again or contact us on WhatsApp.";

      form.appendChild(errorMessage);

    } finally {
      if (submitButton) {
        submitButton.disabled = false;
      }

      if (buttonText) {
        buttonText.textContent = "Schedule My Site Visit";
      }
    }
  });
</script>
