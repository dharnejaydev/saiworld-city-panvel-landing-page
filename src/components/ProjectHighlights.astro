
---
import "../styles/ProjectHighlights.css";

const highlights = [
  {
    eyebrow: "THE TOWNSHIP",
    title: "38 Acres of Possibilities",
    image: "/images/highlights/township-masterplan.webp",
    alt: "Sai World City township masterplan",
  },
  {
    eyebrow: "THE CLUBHOUSE",
    title: "A G+5 Lifestyle Destination",
    image: "/images/highlights/clubhouse.webp",
    alt: "Sai World City clubhouse",
  },
  {
    eyebrow: "A SIGNATURE EXPERIENCE",
    title: "Sky Pool Inspired by Marina Bay",
    image: "/images/highlights/sky-pool.webp",
    alt: "Sai World City sky pool",
  },
  {
    eyebrow: "LANDSCAPED EXPERIENCES",
    title: "Landmarks Within the Landscape",
    image: "/images/highlights/landscape.webp",
    alt: "Sai World City landscaped spaces",
  },
];
---

<section class="project-highlights" id="project-highlights">
  <div class="highlights-container">

    <!-- SECTION HEADING -->
    <div class="highlights-heading">
      <div class="highlights-heading-left">
        <h2>
          Project Highlights
          <span>Sai World City Panvel</span>
        </h2>
      </div>
    </div>

    <!-- PROJECT HIGHLIGHTS CAROUSEL -->
    <div class="highlights-carousel">

      <div class="highlights-track" aria-roledescription="carousel">

        {highlights.map((item, index) => (
          <article
            class:list={[
              "highlight-slide",
              { "is-active": index === 0 }
            ]}
            data-title={item.title}
            data-eyebrow={item.eyebrow}
            aria-hidden={index !== 0 ? "true" : "false"}
          >
            <img
              src={item.image}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />

            <div class="highlight-slide-overlay"></div>

            <div class="highlight-slide-content">
              <span class="highlight-slide-eyebrow">
                {item.eyebrow}
              </span>

              <h3>{item.title}</h3>
            </div>
          </article>
        ))}

        <!-- NAVIGATION ARROWS -->
        <div class="highlights-arrows">
          <button
            class="highlights-arrow highlights-prev"
            type="button"
            aria-label="Previous highlight"
          >
            &#8592;
          </button>

          <button
            class="highlights-arrow highlights-next"
            type="button"
            aria-label="Next highlight"
          >
            &#8594;
          </button>
        </div>

      </div>

      <!-- ENQUIRE BUTTON -->
      <div class="highlights-cta">
        <a
          href="tel:+919920968878"
          class="highlights-enquire-button"
          aria-label="Call Sai World City at 9920968878"
        >
          ENQUIRE NOW
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  // GTM DATA LAYER
  type GTMWindow = Window & {
    dataLayer?: Record<string, string | number>[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(
    eventData: Record<string, string | number>
  ) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // PROJECT HIGHLIGHTS INITIALIZATION
  document.querySelectorAll<HTMLElement>(
    ".project-highlights:not([data-ready])"
  ).forEach((section) => {

    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".highlight-slide")
    );

    const previous = section.querySelector<HTMLButtonElement>(
      ".highlights-prev"
    );

    const next = section.querySelector<HTMLButtonElement>(
      ".highlights-next"
    );

    const track = section.querySelector<HTMLElement>(
      ".highlights-track"
    );

    const enquireButton = section.querySelector<HTMLAnchorElement>(
      ".highlights-enquire-button"
    );

    if (!slides.length) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    // TRACK PROJECT HIGHLIGHTS SECTION VISIBILITY
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            pushGTMEvent({
              event: "project_highlights_section_view",
              section_name: "Project Highlights"
            });

            observer.unobserve(section);
          }

        });
      },
      {
        threshold: 0.3
      }
    );

    observer.observe(section);

    // CAROUSEL SLIDE FUNCTION
    function showSlide(
      index: number,
      interaction?: string
    ) {

      currentIndex =
        (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {

        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);

        slide.setAttribute(
          "aria-hidden",
          String(!active)
        );

      });

      // TRACK ONLY USER-INITIATED SLIDE CHANGES
      if (interaction) {

        pushGTMEvent({
          event: "project_highlights_slide_change",
          slide_number: currentIndex + 1,
          slide_title:
            slides[currentIndex].dataset.title || "",
          slide_eyebrow:
            slides[currentIndex].dataset.eyebrow || "",
          interaction_type: interaction
        });

      }
    }

    // PREVIOUS BUTTON
    previous?.addEventListener("click", () => {

      showSlide(
        currentIndex - 1,
        "previous_button"
      );

    });

    // NEXT BUTTON
    next?.addEventListener("click", () => {

      showSlide(
        currentIndex + 1,
        "next_button"
      );

    });

    // MOBILE SWIPE START
    track?.addEventListener(
      "touchstart",
      (event) => {

        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;

      },
      { passive: true }
    );

    // MOBILE SWIPE END
    track?.addEventListener(
      "touchend",
      (event) => {

        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 45 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {

          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1),
            "mobile_swipe"
          );

        }

      },
      { passive: true }
    );

    // ENQUIRE NOW BUTTON TRACKING
    enquireButton?.addEventListener("click", () => {

      pushGTMEvent({
        event: "project_highlights_enquire_click",
        button_name: "Enquire Now",
        section_name: "Project Highlights",
        destination: "phone_call"
      });

    });

    // INITIAL SLIDE
    showSlide(0);

  });
</script>
