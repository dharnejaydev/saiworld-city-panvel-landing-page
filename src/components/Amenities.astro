
---
import "../styles/Amenities.css";

const amenities = [
  {
    
    title: "Landscaped Amenities",
    category: "OUTDOOR LIFESTYLE",
    image: "/images/amenities/landscaped-amenities.webp",
    alt: "Landscaped outdoor amenities at Sai World City",
  },
  {
   
    title: "Banquet & Entertainment",
    category: "CELEBRATIONS",
    image: "/images/amenities/banquet-entertainment.webp",
    alt: "Banquet and entertainment facilities",
  },
  {
   
    title: "A World of Discovery",
    category: "KIDS & CREATIVITY",
    image: "/images/amenities/world-discovery.webp",
    alt: "Kids and creative amenities",
  },
  {
    
    title: "Merlion Sky Deck",
    category: "AQUA LEISURE",
    image: "/images/amenities/merlion-sky-deck.webp",
    alt: "Merlion Sky Deck and swimming pool",
  },
  {
   
    title: "Move. Play. Create.",
    category: "SPORTS & EXPRESSION",
    image: "/images/amenities/move-play-create.webp",
    alt: "Sports and indoor recreation facilities",
  },
  {
    
    title: "Spa & Wellness",
    category: "RELAXATION & REJUVENATION",
    image: "/images/amenities/spa-wellness.webp",
    alt: "Spa and wellness facilities",
  },
  {
    
    title: "Fitness & Indoor Games",
    category: "FITNESS & RECREATION",
    image: "/images/amenities/fitness-indoor-games.webp",
    alt: "Fitness and indoor games facilities",
  },
  {
    
    title: "The Clubhouse Experience",
    category: "LIFESTYLE & LEISURE",
    image: "/images/amenities/clubhouse-experience.webp",
    alt: "Sai World City clubhouse facilities",
  },
  {
   
    title: "Sai Baba Mandir",
    category: "A SPACE FOR SERENITY",
    image: "/images/amenities/sai-baba-mandir.webp",
    alt: "Sai Baba Mandir at Sai World City",
  },
];
---

<section class="atlas" id="amenities">
  <div class="atlas-shell">

    <!-- SECTION HEADING -->
    <header class="atlas-header">
      <div class="atlas-heading">
        <div class="atlas-heading-left">

          <h2>
            A Thoughtful Collection of Lifestyle Amenities
            <em>In Sai World City Panvel.</em>
          </h2>
        </div>

      </div>
    </header>

    <!-- AMENITIES CAROUSEL -->
    <div class="atlas-carousel">

      {amenities.map((item, index) => (
        <article
          class:list={[
            "atlas-slide",
            { "is-active": index === 0 }
          ]}
          data-slide={index}
          aria-hidden={index !== 0 ? "true" : "false"}
        >

          <!-- IMAGE -->
          <div class="atlas-image">

            <img
              src={item.image}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
            />

            <div class="atlas-image-shade"></div>

            <!-- IMAGE CAPTION -->
            <div class="atlas-image-caption">
              <span>{item.floor}</span>
              <small>{item.category}</small>
              <h3>{item.title}</h3>
            </div>

            <!-- IMAGE ARROWS -->
            <div class="atlas-arrows">
              <button
                class="atlas-arrow atlas-prev"
                type="button"
                aria-label="Previous amenity"
              >
                &#8592;
              </button>

              <button
                class="atlas-arrow atlas-next"
                type="button"
                aria-label="Next amenity"
              >
                &#8594;
              </button>
            </div>

          </div>

        </article>
      ))}

    </div>

    <!-- ENQUIRE BUTTON - ALWAYS BELOW CAROUSEL -->
    <div class="atlas-cta">
      <a
        class="atlas-enquire-button"
        href="tel:+919920968878"
        aria-label="Call Sai World City for an enquiry"
      >
        ENQUIRE NOW
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</section>

<script>
  const atlasSections = document.querySelectorAll<HTMLElement>(
    ".atlas:not([data-ready])"
  );

  atlasSections.forEach((section) => {
    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".atlas-slide")
    );

    const carousel = section.querySelector<HTMLElement>(
      ".atlas-carousel"
    );

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    function showSlide(index: number) {
      if (!slides.length) return;

      // Infinite carousel: last slide returns to first.
      // Previous from first slide returns to last.
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    }

    // Arrow navigation
    slides.forEach((slide) => {
      const previous = slide.querySelector<HTMLButtonElement>(
        ".atlas-prev"
      );

      const next = slide.querySelector<HTMLButtonElement>(
        ".atlas-next"
      );

      previous?.addEventListener("click", () => {
        showSlide(currentIndex - 1);
      });

      next?.addEventListener("click", () => {
        showSlide(currentIndex + 1);
      });
    });

    // Mobile swipe navigation
    carousel?.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    carousel?.addEventListener(
      "touchend",
      (event) => {
        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {
          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1)
          );
        }
      },
      { passive: true }
    );

    showSlide(0);
  });
</script>
