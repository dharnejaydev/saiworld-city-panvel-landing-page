
---
import "../styles/Amenities.css";

const amenities = [
  {
    title: "Club Vegas – A Landmark Experience",
    category: "THE CLUBHOUSE",
    image: "/images/amenities/club-vegas-exterior.webp",
    alt: "Club Vegas exterior and rooftop swimming pool",
  },
  {
    title: "Spaces for Every Celebration",
    category: "BANQUET & ENTERTAINMENT",
    image: "/images/amenities/banquet-entertainment.webp",
    alt: "Banquet and entertainment facilities",
  },
  {
    title: "A World of Discovery for Kids",
    category: "KIDS & CREATIVITY",
    image: "/images/amenities/kids-play-area.webp",
    alt: "Indoor children's play area",
  },
  {
    title: "Gaming & Indoor Entertainment",
    category: "GAMES & LEISURE",
    image: "/images/amenities/gaming-lounge.webp",
    alt: "Indoor gaming lounge",
  },
  {
    title: "Indoor Games & Recreation",
    category: "INDOOR SPORTS",
    image: "/images/amenities/indoor-games-lounge.webp",
    alt: "Indoor games and recreation lounge",
  },
  {
    title: "Table Tennis & Indoor Games",
    category: "ACTIVE LIFESTYLE",
    image: "/images/amenities/table-tennis-games.webp",
    alt: "Table tennis and indoor games facilities",
  },
  {
    title: "A Modern Fitness Experience",
    category: "FITNESS & WELLNESS",
    image: "/images/amenities/modern-gym.webp",
    alt: "Modern gymnasium with fitness equipment",
  },
  {
    title: "Yoga & Mindful Living",
    category: "WELLNESS",
    image: "/images/amenities/yoga-studio.webp",
    alt: "Yoga and meditation studio",
  },
  {
    title: "Outdoor Sports Arena",
    category: "OUTDOOR RECREATION",
    image: "/images/amenities/outdoor-sports-arena.webp",
    alt: "Outdoor sports arena",
  },
  {
    title: "Merlion Sky Deck",
    category: "AQUA LEISURE",
    image: "/images/amenities/merlion-sky-deck-pool.webp",
    alt: "Merlion Sky Deck swimming pool",
  },
  {
    title: "Landscaped Gardens & Green Spaces",
    category: "OUTDOOR LIFESTYLE",
    image: "/images/amenities/landscaped-garden.webp",
    alt: "Landscaped garden and outdoor seating",
  },
  {
    title: "Indoor Games Room",
    category: "GAMES & ENTERTAINMENT",
    image: "/images/amenities/indoor-games-room.webp",
    alt: "Indoor games room",
  },
  {
    title: "A Peaceful Sai Baba Mandir",
    category: "SPIRITUAL SERENITY",
    image: "/images/amenities/sai-baba-mandir.webp",
    alt: "Sai Baba Mandir at Sai World City",
  },
];
---

<section class="atlas" id="amenities">
  <div class="atlas-shell">

    <!-- SECTION HEADING -->
    <header class="atlas-header">
      <div class="atlas-heading">

        <h2>
          A Thoughtful Collection of Lifestyle Amenities
          <em>In Sai World City Panvel.
</em>
        </h2>

        
      </div>
    </header>

    <!-- AMENITIES CAROUSEL -->
    <div class="atlas-carousel" aria-roledescription="carousel">

      {amenities.map((item, index) => (
        <article
          class:list={[
            "atlas-slide",
            { "is-active": index === 0 }
          ]}
          data-slide={index}
          aria-hidden={index !== 0 ? "true" : "false"}
        >
          <div class="atlas-image">

            <!-- AMENITY IMAGE -->
            <img
              src={item.image}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />

            <!-- IMAGE OVERLAY -->
            <div class="atlas-image-shade"></div>

            <!-- IMAGE TITLE -->
            <div class="atlas-image-caption">
              <span class="atlas-image-category">
                {item.category}
              </span>

              <h3>{item.title}</h3>
            </div>

            <!-- NAVIGATION ARROWS -->
            <div class="atlas-arrows">
              <button
                class="atlas-arrow atlas-prev"
                type="button"
                aria-label="Previous amenity"
              >
                &#8592;
              </button>

              <button
                class="atlas-arrow atlas-next"
                type="button"
                aria-label="Next amenity"
              >
                &#8594;
              </button>
            </div>

          </div>
        </article>
      ))}

    </div>

    <!-- ENQUIRE BUTTON -->
    <div class="atlas-cta">
      <a
        class="atlas-enquire-button"
        href="tel:+919920968878"
        aria-label="Call Sai World City for an enquiry"
      >
        ENQUIRE NOW
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</section>

<script>
  const atlasSections = document.querySelectorAll<HTMLElement>(
    ".atlas:not([data-ready])"
  );

  atlasSections.forEach((section) => {
    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".atlas-slide")
    );

    const carousel = section.querySelector<HTMLElement>(
      ".atlas-carousel"
    );

    if (!slides.length || !carousel) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    }

    // Arrow navigation
    carousel.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      if (target.closest(".atlas-prev")) {
        showSlide(currentIndex - 1);
      }

      if (target.closest(".atlas-next")) {
        showSlide(currentIndex + 1);
      }
    });

    // Mobile swipe start
    carousel.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    // Mobile swipe end
    carousel.addEventListener(
      "touchend",
      (event) => {
        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {
          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1)
          );
        }
      },
      { passive: true }
    );

    // Start with first image
    showSlide(0);
  });
</script>
