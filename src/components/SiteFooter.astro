
---
import "../styles/SiteFooter.css";

const links = [
  { label: "Overview", href: "#overview" },
  { label: "Amenities", href: "#amenities" },
  { label: "Configurations", href: "#configurations" },
  { label: "Gallery", href: "#gallery" },
  { label: "Location", href: "#location" },
  { label: "Enquire Now", href: "#contact" },
];

const registrations = [
  {
    phase: "Phase 1",
    number: "P52000006318",
    qr: "/images/rera/phase-1-qr.webp",
  },
  {
    phase: "Phase 2",
    number: "P52000022708",
    qr: "/images/rera/phase-2-qr.webp",
  },
  {
    phase: "Phase 3",
    number: "P52000053727",
    qr: "/images/rera/phase-3-qr.webp",
  },
];

const agentRera = {
  number: "A51900037431",
  qr: "/images/rera/agent-rera-qr.webp",
};
---

<footer class="site-footer">

  <div class="footer-main">
    <div class="footer-container">

      <!-- BRAND -->
      <div class="footer-brand">
        <a href="#top" class="footer-logo">
          SAI WORLD CITY PANVEL<span>.</span>
        </a>

        <span class="footer-location">PANVEL · NAVI MUMBAI</span>

        <a
          class="footer-address"
          href="https://www.google.com/maps/search/?api=1&query=Sai+World+City+Palaspe+Phata+Panvel"
          target="_blank"
          rel="noopener noreferrer"
        >
          Palaspe Phata Junction, Panvel – 410206
        </a>
      </div>

      <!-- NAVIGATION -->
      <div class="footer-navigation">
        <span class="footer-label">EXPLORE</span>
        <h3>Quick Links</h3>

        <nav class="footer-links">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>

      <!-- CONTACT -->
      <div class="footer-contact">
        <span class="footer-label">GET IN TOUCH</span>
        <h3>Let's connect.</h3>

        <a href="tel:+919920968878" class="footer-phone">
          +91 99209 68878
        </a>

        <a href="tel:+918879957281" class="footer-phone">
          +91 88799 57281
        </a>

        <a
          href="https://wa.me/919920968878"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-whatsapp"
        >
          WhatsApp Us
        </a>
      </div>

    </div>
  </div>

  <!-- RERA DETAILS -->
  <div class="footer-legal">
    <div class="footer-legal-inner">

      <!-- PROJECT RERA -->
      <div class="footer-rera">
        <span class="footer-label">PROJECT RERA REGISTRATIONS</span>

        <div class="footer-rera-list">
          {registrations.map((item) => (
            <div class="footer-rera-item">
              <img
                src={item.qr}
                alt={`${item.phase} RERA QR code`}
                class="footer-rera-qr"
                loading="lazy"
              />

              <div class="footer-rera-info">
                <span>{item.phase}</span>
                <strong>{item.number}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- AGENT RERA -->
      <div class="footer-agent">
        <span class="footer-label">STRATEGIC PATNER</span>

        <div class="footer-agent-content">
          <img
            src={agentRera.qr}
            alt="Agent RERA QR code"
            class="footer-rera-qr"
            loading="lazy"
          />

          <div class="footer-rera-info">
            <span>Registration Number</span>
            <strong>{agentRera.number}</strong>
          </div>
        </div>
      </div>

      <!-- DISCLAIMER -->
      <div class="footer-disclaimer">
        <span class="footer-label">DISCLAIMER</span>
        <p>
          The content is for information purposes only and does not constitute
          an offer to avail of any service. Prices mentioned are subject to
          change without notice and properties mentioned are subject to
          availability. Images for representation purposes only. This is the
          official website of CP of the Developer.
        </p>
      </div>

    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">

      <p>
        © {new Date().getFullYear()} Sai World City Panvel. All rights reserved.
      </p>

      <div class="footer-bottom-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <a
          href="https://maharera.maharashtra.gov.in/"
          target="_blank"
          rel="noopener noreferrer"
        >
          MahaRERA
        </a>
      </div>

    </div>
  </div>

</footer>
