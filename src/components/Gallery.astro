
---
import "../styles/Gallery.css";

const galleryItems = [
  {
    category: "THE GRAND ENTRANCE",
    title: "A Remarkable Arrival",
    image: "/images/gallery/entrance.webp",
    alt: "Sai World City entrance",
  },
  {
    category: "AERIAL VIEW",
    title: "A Beautiful View From Above",
    image: "/images/gallery/aerial-view.webp",
    alt: "Aerial view of Sai World City",
  },
  {
    category: "ARCHITECTURE",
    title: "Architecture That Makes a Statement",
    image: "/images/gallery/architecture.webp",
    alt: "Sai World City residential architecture",
  },
  {
    category: "ICONIC LANDMARKS",
    title: "Big Ben Clock Tower",
    image: "/images/gallery/f0e45868-6ce1-4a4c-991b-814a2ce8927.webp",
    alt: "Big Ben inspired landmark at Sai World City",
  },
  {
    category: "PANORAMIC VIEW",
    title: "Discover the Bigger Picture",
    image: "/images/gallery/panoramic-view.webp",
    alt: "Panoramic view of Sai World City",
  },
  {
    category: "PROJECT OVERVIEW",
    title: "A Township Designed Around You",
    image: "/images/gallery/project-overview.webp",
    alt: "Sai World City project overview",
  },
  {
    category: "CLUB VEGAS",
    title: "A World of Leisure & Experiences",
    image: "/images/gallery/project-view.webp",
    alt: "Club Vegas lifestyle and clubhouse",
  },
  {
    category: "MERLION SKY DECK",
    title: "A Splash of Something Special",
    image: "/images/amenities/merlion-sky-deck-pool.webp",
    alt: "Merlion Sky Deck swimming pool",
  },
];
---

<section class="gallery-section" id="gallery">
  <div class="gallery-container">

    <!-- SECTION HEADING -->
    <header class="gallery-heading">
      <h2>
        Discover the World of
        <span>Sai World City Panvel</span>
      </h2>
    </header>

    <!-- GALLERY CAROUSEL -->
    <div class="gallery-carousel" aria-roledescription="carousel">

      {galleryItems.map((item, index) => (
        <article
          class:list={[
            "gallery-slide",
            { "is-active": index === 0 }
          ]}
          data-slide={index}
          data-gallery-title={item.title}
          data-gallery-category={item.category}
          aria-hidden={index !== 0 ? "true" : "false"}
        >

          <!-- FULL IMAGE -->
          <div class="gallery-image-wrap">

            <img
              src={item.image}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />

            <!-- IMAGE SHADE -->
            <div class="gallery-image-overlay"></div>

            <!-- IMAGE TITLE -->
            <div class="gallery-image-content">
              <span class="gallery-image-category">
                {item.category}
              </span>

              <h3>{item.title}</h3>
            </div>

            <!-- IMAGE ARROWS -->
            <div class="gallery-navigation">

              <button
                class="gallery-arrow gallery-prev"
                type="button"
                aria-label="Previous gallery image"
              >
                &#8592;
              </button>

              <button
                class="gallery-arrow gallery-next"
                type="button"
                aria-label="Next gallery image"
              >
                &#8594;
              </button>

            </div>

          </div>
        </article>
      ))}

    </div>

    <!-- ENQUIRE BUTTON -->
    <div class="gallery-cta">
      <a
        href="tel:+919920968878"
        class="gallery-enquire-button"
        aria-label="Call Sai World City for an enquiry"
      >
        ENQUIRE NOW
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</section>

<script>
  // ==========================================
  // GOOGLE TAG MANAGER DATA LAYER
  // ==========================================

  type GTMEvent = Record<string, string | number>;

  type GTMWindow = Window & {
    dataLayer?: GTMEvent[];
  };

  const gtmWindow = window as GTMWindow;

  function pushGTMEvent(eventData: GTMEvent) {
    gtmWindow.dataLayer = gtmWindow.dataLayer || [];
    gtmWindow.dataLayer.push(eventData);
  }

  // ==========================================
  // GALLERY CAROUSEL INITIALIZATION
  // ==========================================

  const gallerySections = document.querySelectorAll<HTMLElement>(
    ".gallery-section:not([data-ready])"
  );

  gallerySections.forEach((section) => {

    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".gallery-slide")
    );

    const carousel = section.querySelector<HTMLElement>(
      ".gallery-carousel"
    );

    const enquireButton = section.querySelector<HTMLAnchorElement>(
      ".gallery-enquire-button"
    );

    if (!slides.length || !carousel) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    // ==========================================
    // TRACK GALLERY SECTION VISIBILITY
    // ==========================================

    const observer = new IntersectionObserver(
      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            pushGTMEvent({
              event: "gallery_section_view",
              section_name: "Project Gallery"
            });

            observer.unobserve(section);
          }

        });

      },
      {
        threshold: 0.3
      }
    );

    observer.observe(section);

    // ==========================================
    // SHOW GALLERY SLIDE
    // ==========================================

    function showSlide(
      index: number,
      interaction?: string
    ) {

      // Infinite navigation
      currentIndex =
        (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {

        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);

        slide.setAttribute(
          "aria-hidden",
          String(!active)
        );

      });

      // TRACK USER-INITIATED SLIDE CHANGES
      if (interaction) {

        const activeSlide = slides[currentIndex];

        pushGTMEvent({
          event: "gallery_slide_change",
          gallery_slide_number: currentIndex + 1,
          gallery_slide_title:
            activeSlide.dataset.galleryTitle || "",
          gallery_category:
            activeSlide.dataset.galleryCategory || "",
          interaction_type: interaction
        });

      }

    }

    // ==========================================
    // ARROW NAVIGATION
    // ==========================================

    carousel.addEventListener("click", (event) => {

      const target = event.target;

      if (!(target instanceof Element)) return;

      if (target.closest(".gallery-prev")) {

        showSlide(
          currentIndex - 1,
          "previous_button"
        );

      }

      if (target.closest(".gallery-next")) {

        showSlide(
          currentIndex + 1,
          "next_button"
        );

      }

    });

    // ==========================================
    // MOBILE SWIPE START
    // ==========================================

    carousel.addEventListener(
      "touchstart",
      (event) => {

        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;

      },
      { passive: true }
    );

    // ==========================================
    // MOBILE SWIPE END
    // ==========================================

    carousel.addEventListener(
      "touchend",
      (event) => {

        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {

          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1),
            "mobile_swipe"
          );

        }

      },
      { passive: true }
    );

    // ==========================================
    // ENQUIRE NOW CLICK TRACKING
    // ==========================================

    enquireButton?.addEventListener("click", () => {

      pushGTMEvent({
        event: "gallery_enquire_click",
        button_name: "Enquire Now",
        section_name: "Project Gallery",
        destination: "phone_call"
      });

    });

    // ==========================================
    // INITIAL SLIDE
    // ==========================================

    showSlide(0);

  });
</script>
