
---
import "../styles/Gallery.css";

const galleryItems = [
  {
    category: "PROJECT OVERVIEW",
    title: "The Grand Perspective",
    image: "/images/gallery/project-overview.webp",
    description:
      "A 32-acre mega township bringing together residential towers, landscaped spaces and Club Vegas."
  },
  {
    category: "ARCHITECTURE",
    title: "A Distinctive Residential Address",
    image: "/images/gallery/architecture.webp",
    alt: "Sai World City architectural development",
    description:
      "Discover thoughtfully planned residential clusters including Marina, Opera, Acropolis, Manhattan, Palazzo and more."
  },
  {
    category: "LANDSCAPED EXPERIENCES",
    title: "A Remarkable Arrival",
    image: "/images/gallery/entrance.webp",
    alt: "Sai World City entrance and landscaped spaces",
    description:
      "A welcoming entrance complemented by landscaped spaces, green walkways, Palms Avenue and a musical fountain."
  },
  {
    category: "AERIAL VIEW",
    title: "The Bigger Picture",
    image: "/images/gallery/aerial-view.webp",
    alt: "Aerial view of Sai World City township",
    description:
      "Get a wider perspective of the township, its residential clusters, internal roads and Club Vegas."
  },
  {
    category: "TOWER EXTERIOR",
    title: "A Distinctive Silhouette",
    image: "/images/gallery/tower-exterior.webp",
    alt: "Sai World City residential tower exterior",
    description:
      "Explore the residential clusters that shape the architectural character of Sai World City."
  },
  {
    category: "CLUB VEGAS",
    title: "A World of Leisure",
    image: "/images/gallery/project-view.webp",
    alt: "Sai World City Club Vegas lifestyle destination",
    description:
      "Experience Club Vegas, a G+5 storied themed family clubhouse with indoor and outdoor lifestyle amenities."
  },
  {
    category: "LANDMARK EXPERIENCES",
    title: "Landmarks Within the Landscape",
    image: "/images/gallery/panoramic-view.webp",
    alt: "Sai World City landscaped landmark features",
    description:
      "Discover landmark-inspired attractions including the Statue of Liberty, Eiffel Tower and Big Ben Clock Tower."
  },
  {
    category: "MERLION SKY DECK",
    title: "A Splash of Something Special",
    image: "/images/amenities/merlion-sky-deck.webp",
    alt: "Merlion Sky Deck at Sai World City",
    description:
      "Enjoy a terrace-level experience featuring a swimming pool, party deck, kids pool and Merlion-inspired setting."
  }
];
---

<section class="gallery-section" id="gallery">
  <div class="gallery-container">

    <!-- SECTION HEADING -->
    <div class="gallery-heading">
      <div class="gallery-heading-left">

        <h2>
          Discover the World of
          <span>Sai World City Panvel</span>
        </h2>
      </div>
    </div>

    <!-- GALLERY -->
    <div class="gallery-carousel">

      <div class="gallery-main-image">

        {galleryItems.map((item, index) => (
          <article
            class:list={[
              "gallery-slide",
              { "is-active": index === 0 }
            ]}
            data-slide={index}
            aria-hidden={index !== 0 ? "true" : "false"}
          >

            <!-- IMAGE -->
            <div class="gallery-image-wrap">
              <img
                src={item.image}
                alt={item.alt}
                loading={index === 0 ? "eager" : "lazy"}
              />

              <div class="gallery-image-overlay"></div>

              <div class="gallery-image-details">
                <span class="gallery-active-category">
                  {item.category}
                </span>
              </div>
            </div>

            <!-- SIMPLE INFORMATION PATCH -->
            <div class="gallery-information">
              <span class="gallery-information-label">
                {item.category}
              </span>

              <h3>{item.title}</h3>

              <p>{item.description}</p>
            </div>

          </article>
        ))}

        <!-- NAVIGATION ARROWS -->
        <div class="gallery-navigation">
          <button
            class="gallery-arrow gallery-prev"
            type="button"
            aria-label="Previous image"
          >
            &#8592;
          </button>

          <button
            class="gallery-arrow gallery-next"
            type="button"
            aria-label="Next image"
          >
            &#8594;
          </button>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const gallerySections = document.querySelectorAll<HTMLElement>(
    ".gallery-section:not([data-ready])"
  );

  gallerySections.forEach((section) => {
    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".gallery-slide")
    );

    const previousButton =
      section.querySelector<HTMLButtonElement>(".gallery-prev");

    const nextButton =
      section.querySelector<HTMLButtonElement>(".gallery-next");

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    function showSlide(index: number) {
      if (!slides.length) return;

      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    }

    previousButton?.addEventListener("click", () => {
      showSlide(currentIndex - 1);
    });

    nextButton?.addEventListener("click", () => {
      showSlide(currentIndex + 1);
    });

    const imageArea = section.querySelector<HTMLElement>(
      ".gallery-main-image"
    );

    imageArea?.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    imageArea?.addEventListener(
      "touchend",
      (event) => {
        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {
          showSlide(currentIndex + (differenceX > 0 ? 1 : -1));
        }
      },
      { passive: true }
    );

    showSlide(0);
  });
</script>
