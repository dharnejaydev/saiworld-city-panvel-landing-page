
---
import "../styles/Overview.css";
---

<section class="overview-section" id="overview">

  <!-- TOP: PROJECT OVERVIEW + 3D IMAGE -->
  <div class="overview-top">

    <div class="overview-content">
      <span class="overview-eyebrow">DISCOVER SAI WORLD CITY PANVEL</span>

      <h2>
        A destination beyond
        <em>expectations.</em>
      </h2>

      <p class="overview-tagline">
        Where thoughtful spaces meet a more fulfilling way of living.
      </p>

      <div class="overview-line"></div>

      <p>
        Sai World City Panvel, by Paradise Group, brings together
        contemporary architecture, thoughtfully planned residences
        and lifestyle experiences within an expansive residential
        development.
      </p>

      <p>
        Designed around the idea of a well-connected community,
        the development brings together residential spaces,
        open areas and lifestyle amenities to create an address
        where everyday living feels more considered.
      </p>

      <p>
        Backed by Paradise Group's experience in real estate
        development, Sai World City Panvel represents the next chapter
        in creating distinctive residential addresses.
      </p>
    </div>

    <!-- 3D PROJECT IMAGE -->
    <div class="overview-visual">
      <div class="overview-image-glow"></div>

      <div class="overview-image-wrap">
        <img
          src="/images/sai-world-city-pool.webp"
          alt="Sai World City residential development and lifestyle spaces"
          class="overview-image"
          loading="lazy"
        />
      </div>

    </div>

  </div>


  <!-- COMBINED PROJECT + DEVELOPER HIGHLIGHTS -->
  <div class="overview-highlights">

    <!-- SIX HIGHLIGHTS -->
    <div class="highlights-grid">

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <path d="M9 40V17L24 7L39 17V40H9Z" />
            <path d="M17 40V27H31V40M16 18H18M23 18H25M30 18H32" />
            <path d="M5 40H43" />
          </svg>
        </span>
        <p>Expansive<br />residential development</p>
      </div>

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <rect x="8" y="8" width="32" height="32" rx="2" />
            <path d="M16 8V16H24V8M32 8V16H40M8 24H16V32H8M24 24H32V32H24M32 40V32H40" />
            <path d="M19 19H21M27 19H29M19 35H21M35 19H37" />
          </svg>
        </span>
        <p>Thoughtfully<br />planned residences</p>
      </div>

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <path d="M8 39H40M12 39V24H36V39M17 24V16H31V24" />
            <path d="M24 5V16M19 10H29M20 30H28M24 30V39" />
            <circle cx="24" cy="10" r="3" />
          </svg>
        </span>
        <p>Lifestyle<br />amenities</p>
      </div>

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <path d="M24 43S10 30 10 19A14 14 0 0 1 38 19C38 30 24 43 24 43Z" />
            <circle cx="24" cy="19" r="5" />
          </svg>
        </span>
        <p>Located in<br />Panvel</p>
      </div>

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <circle cx="24" cy="13" r="6" />
            <circle cx="12" cy="19" r="4" />
            <circle cx="36" cy="19" r="4" />
            <path d="M12 40V35A12 12 0 0 1 36 35V40M3 39V34A9 9 0 0 1 15 26M45 39V34A9 9 0 0 0 33 26" />
          </svg>
        </span>
        <p>Paradise Group<br />developer</p>
      </div>

      <div class="highlight-item">
        <span class="highlight-icon">
          <svg viewBox="0 0 48 48">
            <path d="M7 39H41M12 39V21L24 10L36 21V39" />
            <path d="M19 39V28H29V39M17 22H19M29 22H31" />
            <path d="M24 5V10" />
          </svg>
        </span>
        <p>A community<br />to grow with</p>
      </div>

    </div>


    <!-- DEVELOPER HIGHLIGHTS CONTENT -->
    <div class="highlights-content">


      <h2>
        PROJECT<br />
        <span>&amp; DEVELOPER</span><br />
        HIGHLIGHTS
      </h2>

      <div class="highlights-line"></div>

      <sapan><p>
        The vision and experience of
        <strong>Paradise Group</strong>,
        bringing thoughtfully developed spaces to life.
      </p>
      <span/>

     

      <span class="highlights-decoration">✦</span>

    </div>

  </div>


  <!-- PARADISE GROUP STATISTICS -->
  <div class="overview-stats">

    <div class="overview-stat">
      <span class="stat-number">30<span>+</span></span>
      <span class="stat-label">YEARS OF LEGACY</span>
      <p>Experience in real estate development</p>
    </div>

    <div class="overview-stat">
      <span class="stat-number">5M<span>+</span></span>
      <span class="stat-label">SQ. FT. DELIVERED</span>
      <p>A growing footprint across developments</p>
    </div>

    <div class="overview-stat">
      <span class="stat-number">1000<span>s</span></span>
      <span class="stat-label">HAPPY FAMILIES</span>
      <p>Homes and communities for families</p>
    </div>

  </div>

</section>
