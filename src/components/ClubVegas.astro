
---
import "../styles/ClubVegas.css";

const images = [
  {
    src: "/images/club-vegas/2fe04fe0-1169-45ec-8c2d-f73c0f961813.webp",
    alt: "Club Vegas lounge and indoor leisure space",
    category: "THE LOUNGE",
    title: "Relax In Refined Comfort",
  },
  {
    src: "/images/club-vegas/3eedd957-83ff-400b-9f88-0845ca5f7ab8.webp",
    alt: "Colourful indoor recreation and activity space",
    category: "KIDS & RECREATION",
    title: "Spaces Made For Play",
  },
  {
    src: "/images/club-vegas/103a0e2b-44c5-4ddc-aefc-bc9cc3ed53b6.webp",
    alt: "Private cinema and entertainment room",
    category: "ENTERTAINMENT",
    title: "Your Private Cinema Experience",
  },
  {
    src: "/images/club-vegas/50065c66-67a8-4b62-9dec-827344e08389.webp",
    alt: "Elegant Club Vegas indoor leisure space",
    category: "LUXURY LIVING",
    title: "An Elevated Indoor Experience",
  },
  {
    src: "/images/club-vegas/135652ec-d316-4fe3-8954-8686be76e5f6.webp",
    alt: "Premium indoor gathering and recreation space",
    category: "SOCIAL SPACES",
    title: "Come Together In Style",
  },
  {
    src: "/images/club-vegas/bd4e87a5-1cca-4a94-bbf5-7d4267201a18.webp",
    alt: "Indoor games and recreation at Club Vegas",
    category: "INDOOR RECREATION",
    title: "Make Every Moment Count",
  },
  {
    src: "/images/club-vegas/bddd8593-fe98-4da4-8de1-361d7aa5d020.webp",
    alt: "Indoor badminton court at Club Vegas",
    category: "ACTIVE LIFESTYLE",
    title: "Play, Move And Recharge",
  },
  {
    src: "/images/club-vegas/dea9a5e5-47a9-434f-aa48-1633aa481ee0.webp",
    alt: "Indoor snooker and games area",
    category: "GAMES & LEISURE",
    title: "Leisure Has A New Address",
  },
  {
    src: "/images/amenities/merlion-sky-deck-pool.webp",
    alt: "Merlion Sky Deck swimming pool at Sai World City",
    category: "AQUA LEISURE",
    title: "Merlion Sky Deck",
  },
];
---

<section class="club-vegas" id="club-vegas">
  <div class="club-container">

    <header class="club-heading">
      <h2>
        Introducing Club Vegas At
        <span>Sai World City Panvel</span>
      </h2>
    </header>

    <div class="club-carousel">

      {images.map((image, index) => (
        <article
          class:list={[
            "club-slide",
            { "is-active": index === 0 }
          ]}
          data-slide={index}
          aria-hidden={index !== 0 ? "true" : "false"}
        >
          <div class="club-image-wrap">

            <img
              src={image.src}
              alt={image.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />

            <div class="club-image-shade"></div>

            <div class="club-image-caption">
              <span>{image.category}</span>
              <h3>{image.title}</h3>
            </div>

            <div class="club-navigation">
              <button
                class="club-arrow club-prev"
                type="button"
                aria-label="Previous image"
              >
                &#8592;
              </button>

              <button
                class="club-arrow club-next"
                type="button"
                aria-label="Next image"
              >
                &#8594;
              </button>
            </div>

          </div>
        </article>
      ))}

    </div>

    <div class="club-cta">
      <a
        href="tel:+919920968878"
        class="club-enquire-button"
        aria-label="Call Sai World City for a Club Vegas enquiry"
      >
        ENQUIRE NOW
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(
    ".club-vegas:not([data-ready])"
  ).forEach((section) => {
    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".club-slide")
    );

    const carousel = section.querySelector<HTMLElement>(
      ".club-carousel"
    );

    if (!slides.length || !carousel) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    }

    carousel.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      if (target.closest(".club-prev")) {
        showSlide(currentIndex - 1);
      }

      if (target.closest(".club-next")) {
        showSlide(currentIndex + 1);
      }
    });

    carousel.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    carousel.addEventListener(
      "touchend",
      (event) => {
        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {
          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1)
          );
        }
      },
      { passive: true }
    );

    showSlide(0);
  });
</script>
