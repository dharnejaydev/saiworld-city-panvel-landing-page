
---
import "../styles/ClubVegas.css";

const images = [
  {
    src: "/images/club-vegas/2fe04fe0-1169-45ec-8c2d-f73c0f961813.webp",
    alt: "Club Vegas lounge and indoor leisure space",
  },
  {
    src: "/images/club-vegas/3eedd957-83ff-400b-9f88-045ca5f7ab8.webp",
    alt: "Children's recreation and activity space",
  },
  {
    src: "/images/club-vegas/bddd8593-fe98-4d4a-8de1-361d7aa50d20.webp",
    alt: "Indoor badminton court at Club Vegas",
  },
  {
    src: "/images/club-vegas/50065c66-67a8-4b62-9dec-827344e08389.webp",
    alt: "Club Vegas spa and wellness interior",
  },
  {
    src: "/images/club-vegas/135652ec-d316-4fe3-8954-8686be76e5f6.webp",
    alt: "Indoor recreational facilities at Club Vegas",
  },
  {
    src: "/images/club-vegas/dea9a5e5-47a9-434f-aa48-1633aa481ee0.webp",
    alt: "Club Vegas indoor games area",
  },
  {
    src: "/images/amenities/merlion-sky-deck-pool.webp",
    alt: "Merlion Sky Deck swimming pool at Sai World City",
  },
];
---

<section class="club-vegas" id="club-vegas">
  <div class="club-container">

    <!-- SECTION HEADING -->
    <header class="club-heading">

      <h2>
        Introducing Club Vegas At
        <span>Sai World City Panvel</span>
      </h2>

    </header>

    <!-- IMAGE CAROUSEL -->
    <div class="club-carousel">

      {images.map((image, index) => (
        <article
          class:list={[
            "club-slide",
            { "is-active": index === 0 }
          ]}
          data-slide={index}
          aria-hidden={index !== 0 ? "true" : "false"}
        >

          <div class="club-image-wrap">

            <img
              src={image.src}
              alt={image.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />

            <!-- IMAGE NAVIGATION -->
            <div class="club-navigation">

              <button
                class="club-arrow club-prev"
                type="button"
                aria-label="Previous image"
              >
                &#8592;
              </button>

              <button
                class="club-arrow club-next"
                type="button"
                aria-label="Next image"
              >
                &#8594;
              </button>

            </div>

          </div>

        </article>
      ))}

    </div>

    <!-- ENQUIRE BUTTON -->
    <div class="club-cta">
      <a
        href="tel:+919920968878"
        class="club-enquire-button"
        aria-label="Call Sai World City for a Club Vegas enquiry"
      >
        ENQUIRE NOW
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>

  </div>
</section>

<script>
  const clubSections = document.querySelectorAll<HTMLElement>(
    ".club-vegas:not([data-ready])"
  );

  clubSections.forEach((section) => {
    section.setAttribute("data-ready", "true");

    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".club-slide")
    );

    const carousel = section.querySelector<HTMLElement>(
      ".club-carousel"
    );

    if (!slides.length || !carousel) return;

    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
    }

    // Previous and next navigation
    carousel.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Element)) return;

      if (target.closest(".club-prev")) {
        showSlide(currentIndex - 1);
      }

      if (target.closest(".club-next")) {
        showSlide(currentIndex + 1);
      }
    });

    // Mobile swipe start
    carousel.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;
      },
      { passive: true }
    );

    // Mobile swipe end
    carousel.addEventListener(
      "touchend",
      (event) => {
        const differenceX =
          touchStartX - event.changedTouches[0].screenX;

        const differenceY =
          touchStartY - event.changedTouches[0].screenY;

        if (
          Math.abs(differenceX) > 50 &&
          Math.abs(differenceX) > Math.abs(differenceY)
        ) {
          showSlide(
            currentIndex + (differenceX > 0 ? 1 : -1)
          );
        }
      },
      { passive: true }
    );

    showSlide(0);
  });
</script>
