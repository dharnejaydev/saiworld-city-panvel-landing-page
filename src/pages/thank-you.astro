
---
import "../styles/thank-you.css";

const projectName = "Sai World City Panvel";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Thank You | Sai World City Panvel</title>

    <meta
      name="description"
      content="Thank you for your enquiry. Our team will contact you shortly regarding Sai World City Panvel."
    />

    <meta name="robots" content="noindex, nofollow" />

    <!-- ======================================
         GOOGLE TAG MANAGER
         ====================================== -->

    <script>
      window.dataLayer = window.dataLayer || [];
    </script>

    <script>
      (function(w,d,s,l,i){
        w[l]=w[l]||[];
        w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
        f.parentNode?.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WG8BLS6D');
    </script>
  </head>

  <body>

    <!-- GOOGLE TAG MANAGER NOSCRIPT -->

    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WG8BLS6D"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <main class="thankyou-page">

      <!-- BACKGROUND DECORATION -->
      <div class="thankyou-decoration thankyou-decoration-one"></div>
      <div class="thankyou-decoration thankyou-decoration-two"></div>

      <!-- THANK YOU CARD -->
      <section class="thankyou-card">

        <!-- LOGO -->
        <a href="/" class="thankyou-logo">
          <img
            src="/images/logo/sai-world-city-logo.webp"
            alt="Sai World City Panvel"
          />
        </a>

        <!-- SUCCESS ICON -->
        <div class="thankyou-success-icon">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="29" />
            <path d="M19 32L28 41L46 23" />
          </svg>
        </div>

        <!-- CONTENT -->
        <span class="thankyou-eyebrow">
          ENQUIRY SUBMITTED SUCCESSFULLY
        </span>

        <h1>
          Thank You<span>.</span>
        </h1>

        <p class="thankyou-message">
          Your interest in <strong>{projectName}</strong> means a lot to us.
          Our team has received your enquiry and will get in touch with you
          shortly.
        </p>

        <!-- DIVIDER -->
        <div class="thankyou-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <p class="thankyou-note">
          Looking forward to welcoming you home.
        </p>

        <!-- BUTTONS -->
        <div class="thankyou-actions">

          <a href="/" class="thankyou-home-btn">
            Back to Home
            <span>→</span>
          </a>

          <a
            href="https://wa.me/919920968878?text=Hi%2C%20I%20have%20submitted%20an%20enquiry%20for%20Sai%20World%20City%20Panvel."
            target="_blank"
            rel="noopener noreferrer"
            class="thankyou-whatsapp-btn"
          >
            Contact Us on WhatsApp
          </a>

        </div>

        <!-- FOOTER -->
        <div class="thankyou-footer">
          <span>SAI WORLD CITY PANVEL</span>
          <span>PALASPE PHATA</span>
        </div>

      </section>

    </main>

    <!-- ======================================
         GOOGLE TAG MANAGER EVENT TRACKING
         ====================================== -->

    <script>
      // ======================================
      // GTM DATA LAYER
      // ======================================

      type GTMEvent = Record<string, string | number>;

      type GTMWindow = Window & {
        dataLayer?: GTMEvent[];
      };

      const gtmWindow = window as GTMWindow;

      function pushGTMEvent(eventData: GTMEvent) {
        gtmWindow.dataLayer = gtmWindow.dataLayer || [];
        gtmWindow.dataLayer.push(eventData);
      }

      // ======================================
      // THANK YOU PAGE VIEW
      // ======================================

      pushGTMEvent({
        event: "thank_you_page_view",
        page_name: "Thank You Page",
        page_type: "conversion_confirmation",
        project_name: "Sai World City Panvel"
      });

      // ======================================
      // WHATSAPP CLICK TRACKING
      // ======================================

      const whatsappButton =
        document.querySelector<HTMLAnchorElement>(
          ".thankyou-whatsapp-btn"
        );

      whatsappButton?.addEventListener("click", () => {

        pushGTMEvent({
          event: "thank_you_whatsapp_click",
          cta_name: "Contact Us on WhatsApp",
          cta_location: "Thank You Page",
          cta_type: "whatsapp"
        });

      });

      // ======================================
      // BACK TO HOME CLICK TRACKING
      // ======================================

      const homeButton =
        document.querySelector<HTMLAnchorElement>(
          ".thankyou-home-btn"
        );

      homeButton?.addEventListener("click", () => {

        pushGTMEvent({
          event: "thank_you_home_click",
          cta_name: "Back to Home",
          cta_location: "Thank You Page"
        });

      });

    </script>

  </body>
</html>
